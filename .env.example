# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is already gitignored — never commit real keys.
#
# Vite only exposes variables prefixed with VITE_ to the browser, and it reads
# them at build time: after editing this file, restart `npm run dev`.

# ── Supabase ────────────────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
#   URL  → "Project URL"
#   KEY  → the browser-safe key. Supabase renamed these, so you'll see one of:
#            newer projects: "Publishable key"  → starts with sb_publishable_
#            older projects: "anon / public"    → a long eyJ... JWT
#          Either works here; the variable name stays VITE_SUPABASE_ANON_KEY.
#
# That key is safe in the browser. It is not a secret — Row Level Security is
# what protects your data. NEVER put the secret key in this file: that's the
# one labelled "Secret key" (sb_secret_...) or "service_role" — it bypasses
# every policy in schema.sql.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# ── Google Calendar (optional) ──────────────────────────────────────────────
# The organization calendar's ID: Google Calendar → the calendar's Settings →
# "Integrate calendar" → Calendar ID. Usually an address ending in
# @group.calendar.google.com, or just your Gmail address for a personal one.
#
# The calendar must be set to "Make available to public" for the embed to
# render — Google's iframe doesn't carry your users' sessions.
VITE_GOOGLE_CALENDAR_ID=
